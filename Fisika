                const htmlContent = `
                    <span class="w-7 text-right mr-3 opacity-80">${item.level}</span>
                    <span class="flex-1 text-left">${item.amount}${starBadge}</span>
                `;

                const liDesktop = document.createElement('li');
                liDesktop.className = baseClasses;
                liDesktop.innerHTML = htmlContent;
                desktopList.appendChild(liDesktop);

                const liMobile = document.createElement('li');
                liMobile.className = baseClasses;
                liMobile.innerHTML = htmlContent;
                mobileList.appendChild(liMobile);
            });
        }

        function getGuaranteedPrizeAmount() {
            // Mengembalikan hadiah titik aman terakhir yang sudah dilewati
            if (currentQuestionIndex >= 10) return PRIZE_LADDER[9].amount; // Rp 32.000.000
            if (currentQuestionIndex >= 5) return PRIZE_LADDER[4].amount;  // Rp 1.000.000
            return "Rp 0";
        }

        function getCurrentEarnedAmount() {
            // Hadiah yang sudah dimenangkan jika pemain berhenti (Walk Away) sebelum menjawab soal saat ini
            if (currentQuestionIndex === 0) return "Rp 0";
            return PRIZE_LADDER[currentQuestionIndex - 1].amount;
        }

        /**
         * 6. ALUR UTAMA PERMAINAN
         */
        function startGame() {
            sound.init();
            currentQuestionIndex = 0;
            lifelines = { fiftyFifty: false, audience: false, phone: false };

            // Reset tombol bantuan
            ['lifeline5050', 'lifelineAudience', 'lifelinePhone'].forEach(id => {
                const btn = document.getElementById(id);
                btn.disabled = false;
                btn.classList.remove('lifeline-used');
            });

            startScreen.classList.add('hidden');
            endScreen.classList.add('hidden');
            gameScreen.classList.remove('hidden');
            walkAwayBtn.classList.remove('hidden');

            loadQuestion();
        }

        function loadQuestion() {
            isAnswering = true;
            eliminatedOptions = [];
            const qData = QUESTIONS[currentQuestionIndex];
            const prizeData = PRIZE_LADDER[currentQuestionIndex];

            // Update UI Header & Studio
            document.getElementById('qNumberBadge').textContent = prizeData.level;
            document.getElementById('qPrizeBadge').textContent = prizeData.amount;
            document.getElementById('centerQNum').textContent = prizeData.level;
            document.getElementById('difficultyTag').textContent = qData.difficulty;
            document.getElementById('safeHavenText').textContent = getGuaranteedPrizeAmount();

            // Tampilkan centerpiece studio, sembunyikan kotak penjelasan
            document.getElementById('studioCenterpiece').classList.remove('hidden');
            document.getElementById('explanationBox').classList.add('hidden');

            // Isi teks pertanyaan dan pilihan
            document.getElementById('questionText').textContent = qData.question;
            for (let i = 0; i < 4; i++) {
                const btn = document.getElementById(`optBtn${i}`);
                const txt = document.getElementById(`optText${i}`);
                
                btn.disabled = false;
                btn.className = "answer-btn flex items-center px-5 py-3.5 sm:py-4 text-left";
                btn.style.visibility = "visible";
                txt.textContent = qData.options[i];
            }

            // Tombol Walk Away hanya aktif jika sudah melewati minimal 1 soal
            if (currentQuestionIndex > 0) {
                walkAwayBtn.disabled = false;
                walkAwayBtn.classList.remove('opacity-40', 'cursor-not-allowed');
            } else {
                walkAwayBtn.disabled = true;
                walkAwayBtn.classList.add('opacity-40', 'cursor-not-allowed');
            }

            renderMoneyLadder();
            sound.playQuestionStart();
        }

        function selectAnswer(selectedIndex) {
            if (!isAnswering) return;
            isAnswering = false;

            const qData = QUESTIONS[currentQuestionIndex];
            const selectedBtn = document.getElementById(`optBtn${selectedIndex}`);
            const correctBtn = document.getElementById(`optBtn${qData.correct}`);

            // Kunci semua tombol pilihan & Walk Away sementara
            for (let i = 0; i < 4; i++) {
                document.getElementById(`optBtn${i}`).disabled = true;
            }
            walkAwayBtn.disabled = true;

            // Efek "Jawaban Dikunci" (Oranye) + Suara ketegangan
            selectedBtn.classList.add('answer-locked');
            sound.playLockAnswer();

            // Jeda dramatis 1.4 detik sebelum mengungkap jawaban benar/salah
            setTimeout(() => {
                selectedBtn.classList.remove('answer-locked');
                const isCorrect = selectedIndex === qData.correct;

                if (isCorrect) {
                    selectedBtn.classList.add('answer-correct');
                    sound.playCorrect();
                    showExplanation(true, qData.explanation);
                } else {
                    selectedBtn.classList.add('answer-wrong');
                    correctBtn.classList.add('answer-correct');
                    sound.playWrong();
                    showExplanation(false, qData.explanation);
                }
            }, 1400);
        }

        function showExplanation(isCorrect, explanationText) {
            document.getElementById('studioCenterpiece').classList.add('hidden');
            const expBox = document.getElementById('explanationBox');
            const expIcon = document.getElementById('expIcon');
            const expTitle = document.getElementById('expTitle');
            const expText = document.getElementById('expText');
            const nextBtn = document.getElementById('nextActionBtn');

            expBox.classList.remove('hidden', 'border-green-500', 'border-red-500');

            if (isCorrect) {
                expBox.classList.add('border-green-500');
                expIcon.className = "w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center text-xl mt-0.5 bg-green-500/20 text-green-400 border border-green-400";
                expIcon.innerHTML = '<i class="fa-solid fa-check"></i>';
                expTitle.className = "font-extrabold text-base sm:text-lg mb-1 text-green-400";
                expTitle.textContent = `Jawaban Benar! Kamu mengamankan ${PRIZE_LADDER[currentQuestionIndex].amount}`;
                
                if (currentQuestionIndex === QUESTIONS.length - 1) {
                    nextBtn.className = "px-6 py-2.5 rounded-full font-extrabold text-sm uppercase tracking-wider shadow-lg bg-gradient-to-r from-yellow-400 to-amber-500 text-slate-950 transition transform hover:scale-105";
                    nextBtn.innerHTML = 'Klaim Hadiah 1 Miliar! <i class="fa-solid fa-trophy ml-1.5"></i>';
                    nextBtn.onclick = () => finishGame('win');
                } else {
                    nextBtn.className = "px-6 py-2.5 rounded-full font-bold text-sm uppercase tracking-wider shadow-lg bg-green-600 hover:bg-green-500 text-white transition transform hover:scale-105";
                    nextBtn.innerHTML = 'Lanjut ke Soal Berikutnya <i class="fa-solid fa-arrow-right ml-1.5"></i>';
                    nextBtn.onclick = () => {
                        currentQuestionIndex++;
                        loadQuestion();
                    };
                }
            } else {
                expBox.classList.add('border-red-500');
                expIcon.className = "w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center text-xl mt-0.5 bg-red-500/20 text-red-400 border border-red-400";
                expIcon.innerHTML = '<i class="fa-solid fa-xmark"></i>';
                expTitle.className = "font-extrabold text-base sm:text-lg mb-1 text-red-400";
                expTitle.textContent = "Sayang Sekali, Jawabanmu Kurang Tepat!";

                nextBtn.className = "px-6 py-2.5 rounded-full font-bold text-sm uppercase tracking-wider shadow-lg bg-red-600 hover:bg-red-500 text-white transition transform hover:scale-105";
                nextBtn.innerHTML = 'Lihat Ringkasan Hasil <i class="fa-solid fa-flag-checkered ml-1.5"></i>';
                nextBtn.onclick = () => finishGame('wrong');
            }

            expText.textContent = explanationText;
        }

        /**
         * 7. FITUR 3 BANTUAN (LIFELINES)
         */
        // A. Bantuan 50:50
        function use5050() {
            if (!isAnswering || lifelines.fiftyFifty) return;
            lifelines.fiftyFifty = true;
            sound.playLifeline();

            const btn = document.getElementById('lifeline5050');
            btn.disabled = true;
            btn.classList.add('lifeline-used');

            const correctIdx = QUESTIONS[currentQuestionIndex].correct;
            const wrongIndices = [0, 1, 2, 3].filter(i => i !== correctIdx);
            
            // Acak dan pilih 2 jawaban salah untuk dihilangkan
            wrongIndices.sort(() => Math.random() - 0.5);
            eliminatedOptions = [wrongIndices[0], wrongIndices[1]];

            eliminatedOptions.forEach(idx => {
                const optBtn = document.getElementById(`optBtn${idx}`);
                optBtn.disabled = true;
                optBtn.style.visibility = "hidden";
            });
        }

        // B. Bantuan Tanya Penonton (Ask the Audience)
        function useAudience() {
            if (!isAnswering || lifelines.audience) return;
            lifelines.audience = true;
            sound.playLifeline();

            const btn = document.getElementById('lifelineAudience');
            btn.disabled = true;
            btn.classList.add('lifeline-used');

            const correctIdx = QUESTIONS[currentQuestionIndex].correct;
            // Akurasi penonton menurun sedikit seiring bertambahnya kesulitan soal
            let baseCorrectPct = currentQuestionIndex < 5 ? 74 : (currentQuestionIndex < 10 ? 58 : 44);
            baseCorrectPct += Math.floor(Math.random() * 12) - 4;

            let percentages = [0, 0, 0, 0];
            let remaining = 100 - baseCorrectPct;

            // Opsi aktif yang tidak dieliminasi oleh 50:50
            const activeIndices = [0, 1, 2, 3].filter(i => !eliminatedOptions.includes(i));
            const otherActive = activeIndices.filter(i => i !== correctIdx);

            percentages[correctIdx] = baseCorrectPct;

            // Distribusikan sisa persentase ke opsi aktif lainnya
            otherActive.forEach((idx, pos) => {
                if (pos === otherActive.length - 1) {
                    percentages[idx] = remaining;
                } else {
                    const share = Math.floor(Math.random() * (remaining + 1));
                    percentages[idx] = share;
                    remaining -= share;
                }
            });

            // Buka modal & animasikan grafik batang
            openModal('audienceModal');
            setTimeout(() => {
                for (let i = 0; i < 4; i++) {
                    document.getElementById(`audPct${i}`).textContent = `${percentages[i]}%`;
                    document.getElementById(`audBar${i}`).style.height = `${percentages[i]}%`;
                }
            }, 100);
        }

        // C. Bantuan Telepon Teman (Phone a Friend)
        function usePhone() {
            if (!isAnswering || lifelines.phone) return;
            lifelines.phone = true;
            sound.playLifeline();

            const btn = document.getElementById('lifelinePhone');
            btn.disabled = true;
            btn.classList.add('lifeline-used');

            const qData = QUESTIONS[currentQuestionIndex];
            const letters = ['A', 'B', 'C', 'D'];
            const correctLetter = letters[qData.correct];
            const correctText = qData.options[qData.correct];

            let dialog = "";
            if (currentQuestionIndex < 5) {
                dialog = `"Halo! Wah, soal materi Gaya ini aku hafal banget. Jawabannya pasti ${correctLetter} (${correctText}). Kunci saja pilihan ${correctLetter}, aku yakin 100%!"`;
            } else if (currentQuestionIndex < 11) {
                dialog = `"Hmm, sebentar aku hitung dulu ya... Berdasarkan rumus Fisika yang kupelajari di kuliah, arah dan nilainya mengarah ke ${correctLetter} (${correctText}). Aku sekitar 85% yakin jawabannya ${correctLetter}."`;
            } else {
                // Soal sangat sulit (12-15): Teman memberikan analisis cermat
                const activeWrong = [0, 1, 2, 3].filter(i => i !== qData.correct && !eliminatedOptions.includes(i));
                const secondGuess = letters[activeWrong[0]];
                dialog = `"Waduh, soal tingkat tinggi nih! Kalau kita analisis hukum Newton dan gayanya secara teliti, kemungkinan besar jawabannya ${correctLetter} (${correctText}), meskipun aku sempat ragu sedikit dengan ${secondGuess}. Tapi aku lebih condong ke ${correctLetter}."`;
            }

            document.getElementById('phoneFriendMessage').textContent = dialog;
            openModal('phoneModal');
        }

        /**
         * 8. AMBIL HADIAH (WALK AWAY) & AKHIR PERMAINAN
         */
        function confirmWalkAway() {
            if (!isAnswering || currentQuestionIndex === 0) return;
            document.getElementById('walkAwayAmountText').textContent = getCurrentEarnedAmount();
            openModal('walkAwayModal');
        }

        function executeWalkAway() {
            closeModal('walkAwayModal');
            finishGame('walkaway');
        }

        function finishGame(reason) {
            sound.stopHeartbeat();
            gameScreen.classList.add('hidden');
            walkAwayBtn.classList.add('hidden');
            endScreen.classList.remove('hidden');

            const endTitle = document.getElementById('endTitle');
            const endSubtitle = document.getElementById('endSubtitle');
            const endBadgeIcon = document.getElementById('endBadgeIcon');
            const finalPrizeAmount = document.getElementById('finalPrizeAmount');

            let finalMoney = "Rp 0";
            let solvedCount = currentQuestionIndex;

            if (reason === 'win') {
                solvedCount = 15;
                finalMoney = PRIZE_LADDER[14].amount;
                endTitle.textContent = "LUAR BIASA! MILIARDER FISIKA!";
                endSubtitle.textContent = "Kamu berhasil menaklukkan seluruh 15 pertanyaan materi Gaya dengan sempurna!";
                endBadgeIcon.innerHTML = '<i class="fa-solid fa-crown"></i>';
                sound.playVictory();
            } else if (reason === 'walkaway') {
                solvedCount = currentQuestionIndex;
                finalMoney = getCurrentEarnedAmount();
                endTitle.textContent = "Keputusan Cerdas!";
                endSubtitle.textContent = `Kamu memilih berhenti di soal ke-${currentQuestionIndex + 1} dan mengamankan hadiah yang sudah diraih.`;
                endBadgeIcon.innerHTML = '<i class="fa-solid fa-sack-dollar"></i>';
                sound.playVictory();
            } else if (reason === 'wrong') {
                solvedCount = currentQuestionIndex;
                finalMoney = getGuaranteedPrizeAmount();
                endTitle.textContent = "Permainan Berakhir";
                endSubtitle.textContent = finalMoney === "Rp 0" 
                    ? "Kamu belum mencapai Titik Aman pertama (Soal ke-5). Ayo coba lagi!" 
                    : "Untungnya kamu sudah melewati Titik Aman sehingga hadiah amanmu tetap terjaga!";
                endBadgeIcon.innerHTML = '<i class="fa-solid fa-atom"></i>';
            }

            finalPrizeAmount.textContent = finalMoney;
            document.getElementById('statCorrectCount').textContent = `${solvedCount} / 15`;

            const usedCount = Object.values(lifelines).filter(Boolean).length;
            document.getElementById('statLifelinesUsed').textContent = `${usedCount} / 3`;
        }

        function restartGame() {
            startGame();
        }

        /**
         * 9. UTILITAS MODAL & AUDIO TOGGLE
         */
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function toggleMobileLadder() {
            const modal = document.getElementById('mobileLadderModal');
            modal.classList.toggle('hidden');
        }

        function toggleAudio() {
            const muted = sound.toggleMute();
            const icon = document.getElementById('audioIcon');
            if (muted) {
                icon.className = "fa-solid fa-volume-xmark text-red-400";
            } else {
                icon.className = "fa-solid fa-volume-high text-yellow-400";
                if (isAnswering && !gameScreen.classList.contains('hidden')) {
                    sound.startHeartbeat();
                }
            }
        }
    </script>
</body>
</html>
