         * 1. WEB AUDIO API SYNTHESIZER
         * Menghasilkan efek suara dramatis khas acara TV tanpa file eksternal.
         */
        class SoundEngine {
            constructor() {
                this.ctx = null;
                this.isMuted = false;
                this.bgInterval = null;
            }

            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioContext();
                }
                if (this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            toggleMute() {
                this.isMuted = !this.isMuted;
                if (this.isMuted) {
                    this.stopHeartbeat();
                }
                return this.isMuted;
            }

            // Nada dasar dengan amplop halus
            playTone(freq, type = 'sine', duration = 0.5, volume = 0.15, delay = 0) {
                if (this.isMuted) return;
                try {
                    this.init();
                    const now = this.ctx.currentTime + delay;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    osc.type = type;
                    osc.frequency.setValueAtTime(freq, now);

                    gain.gain.setValueAtTime(0.001, now);
                    gain.gain.exponentialRampToValueAtTime(volume, now + 0.03);
                    gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.start(now);
                    osc.stop(now + duration + 0.05);
                } catch (e) {
                    // Abaikan jika browser memblokir autoplay sebelum interaksi
                }
            }

            // Suara mulai game / masuk soal baru
            playQuestionStart() {
                this.playTone(130.81, 'triangle', 0.8, 0.18, 0);     // C3
                this.playTone(196.00, 'triangle', 0.8, 0.15, 0.12);  // G3
                this.playTone(261.63, 'sine', 1.1, 0.18, 0.24);      // C4
                this.startHeartbeat();
            }

            // Detak jantung ketegangan latar belakang
            startHeartbeat() {
                this.stopHeartbeat();
                if (this.isMuted) return;
                this.bgInterval = setInterval(() => {
                    if (this.isMuted) return;
                    this.playTone(65.41, 'sine', 0.22, 0.12, 0);     // C2 rendah
                    this.playTone(65.41, 'sine', 0.18, 0.08, 0.25);
                }, 1400);
            }

            stopHeartbeat() {
                if (this.bgInterval) {
                    clearInterval(this.bgInterval);
                    this.bgInterval = null;
                }
            }

            // Suara saat mengunci jawaban ("Final Answer?")
            playLockAnswer() {
                this.stopHeartbeat();
                this.playTone(220, 'sawtooth', 0.4, 0.12, 0);
                this.playTone(277.18, 'sawtooth', 0.4, 0.12, 0.15);
                this.playTone(329.63, 'triangle', 0.9, 0.18, 0.3);
            }

            // Suara jawaban benar (Fanfare naik)
            playCorrect() {
                this.stopHeartbeat();
                const notes = [261.63, 329.63, 392.00, 523.25]; // C4, E4, G4, C5
                notes.forEach((n, idx) => {
                    this.playTone(n, 'triangle', 0.65, 0.2, idx * 0.1);
                    this.playTone(n * 1.5, 'sine', 0.65, 0.08, idx * 0.1);
                });
            }

            // Suara jawaban salah (Nada turun dramatis)
            playWrong() {
                this.stopHeartbeat();
                this.playTone(196.00, 'sawtooth', 0.5, 0.16, 0);
                this.playTone(138.59, 'sawtooth', 1.1, 0.18, 0.25); // Tritone / dissonant
                this.playTone(98.00, 'sine', 1.2, 0.22, 0.25);
            }

            // Suara menggunakan bantuan (Lifeline)
            playLifeline() {
                this.playTone(587.33, 'sine', 0.25, 0.16, 0);      // D5
                this.playTone(880.00, 'sine', 0.45, 0.16, 0.12);   // A5
            }

