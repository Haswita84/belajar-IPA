                this.stopHeartbeat();
                const melody = [261.63, 329.63, 392.00, 523.25, 392.00, 523.25, 659.25];
                melody.forEach((freq, i) => {
                    this.playTone(freq, 'triangle', 0.5, 0.2, i * 0.14);
                });
            }
        }

